# 007DataDestroyer — data/ ist standardmäßig NICHT öffentlich.
# Die hier liegenden Daten sollen im Zweifel gelöscht, nicht ausgeliefert werden.
# Wenn du die Inhalte bewusst per URL erreichbar machen willst, diese Datei anpassen.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
